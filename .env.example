# =============================================================================
# VoiceEval configuration. Copy to .env and fill in what you need.
# Restart the server after editing (keys can also be managed in the UI: Settings).
# =============================================================================

# --- LLM judge: put the key for ANY ONE (or more) provider ---------------------
# Which provider to use: auto | anthropic | openai | gemini | openai_compatible | none
#   auto = the first provider below that has a key (anthropic → openai → gemini → compatible)
VOICEEVAL_JUDGE=auto

# Anthropic Claude          https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
VOICEEVAL_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI (ChatGPT)          https://platform.openai.com/api-keys
OPENAI_API_KEY=
VOICEEVAL_OPENAI_MODEL=gpt-5

# Google Gemini             https://aistudio.google.com/apikey
GEMINI_API_KEY=
VOICEEVAL_GEMINI_MODEL=gemini-2.5-pro

# Any OpenAI-compatible API (OpenRouter, Groq, Together, DeepSeek, Azure OpenAI, Ollama, vLLM…)
VOICEEVAL_JUDGE_BASE_URL=
VOICEEVAL_JUDGE_API_KEY=
VOICEEVAL_OPENAI_COMPATIBLE_MODEL=

# Reasoning effort for Anthropic (low | medium | high | xhigh | max)
VOICEEVAL_JUDGE_EFFORT=medium

# --- Transcription ------------------------------------------------------------
VOICEEVAL_TRANSCRIBER=auto                # auto | sidecar | faster_whisper | none
VOICEEVAL_WHISPER_MODEL=base.en

# --- Storage / execution -------------------------------------------------------
# VOICEEVAL_DATA_DIR=/absolute/path/to/data   # default: ./data inside the project
# DATABASE_URL=postgresql+psycopg://user:pass@host/voiceeval   # default: SQLite in data/
VOICEEVAL_EXECUTOR=local                  # local = in-process workers; worker = separate `voiceeval worker` processes
VOICEEVAL_LOCAL_WORKERS=4
