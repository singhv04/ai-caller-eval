]},"turns":[{"speaker":"ai","start":0.57,"end":9.65,"text":"Hi, thanks for calling Brightside Dental. I'm Ava, a virtual assistant, and this call may be recorded for quality. How can I help you today?","index":0},{"speaker":"human","start":10.17,"end":12.75,"text":"Hi, I need to move my cleaning appointment.","index":1},{"speaker":"ai","start":13.33,"end":17.61,"text":"Sure, I can help with that. Can I have your full name and date of birth?","index":2},{"speaker":"human","start":18.19,"end":21.69,"text":"Maria Lopez, March fourth, nineteen eighty six.","index":3},{"speaker":"ai","start":22.39,"end":31.61,"text":"Thanks, Maria. I see your cleaning on Tuesday at ten AM with Doctor Patel. What day would work better for you? We have openings on Wednesday morning,","index":4},{"speaker":"human","start":31.29,"end":32.83,"text":"Thursday afternoon please.","index":5},{"speaker":"ai","start":33.47,"end":39.41,"text":"Of course. Thursday at two thirty PM is open with Doctor Patel. Shall I book that for you?","index":6},{"speaker":"human","start":39.77,"end":40.59,"text":"Yes please.","index":7},{"speaker":"ai","start":41.11,"end":50.27,"text":"Done. You're booked for Thursday at two thirty PM. As a reminder, cleanings take about forty five minutes. Is there anything else I can help with?","index":8},{"speaker":"human","start":49.67,"end":51.85,"text":"No, that's all. Thank you.","index":9},{"speaker":"ai","start":52.31,"end":55.15,"text":"You're welcome, Maria. Have a great day!","index":10}],"transcript_source":"sidecar"}